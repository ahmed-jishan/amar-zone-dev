[
  {
    "id": "morning",
    "name": "Morning Duas",
    "nameBn": "সকালের দোয়া",
    "duas": [
      {
        "id": "morning-1",
        "arabic": "أَصْبَحْنَا وَأَصْبَحَ الْمُلْكُ لِلَّهِ",
        "transliteration": "Asbahna wa asbahal mulku lillah",
        "translation": "We have entered morning and all sovereignty belongs to Allah.",
        "reference": "Sahih Musli"
      },
      {
        "id": "morning-2",
        "arabic": "اللَّهُمَّ بِكَ أَصْبَحْنَا وَبِكَ أَمْسَيْنَا",
        "transliteration": "Allahumma bika asbahna wa bika amsayna",
        "translation": "O Allah, by You we enter morning and by You we enter evening.",
        "reference": "Abu Dawud"
      },
      {
        "id": "morning-3",
        "arabic": "اللَّهُمَّ بِكَ أَصْبَحْنَا وَبِكَ أَمْسَيْنَا",
        "transliteration": "Allahumma bika asbahna wa bika amsayna",
        "translation": "O Allah, by You we enter morning and by You we enter evening.",
        "reference": "Abu Dawud"
      }
    ]
  },
  {
    "id": "evening",
    "name": "Evening Duas",
    "nameBn": "সন্ধ্যার দোয়া",
    "duas": [
      {
        "id": "evening-1",
        "arabic": "أَمْسَيْنَا وَأَمْسَى الْمُلْكُ لِلَّهِ",
        "transliteration": "Amsayna wa amsal mulku lillah",
        "translation": "We have entered evening and all sovereignty belongs to Allah.",
        "reference": "Sahih Muslim"
      }
    ]
  },
  {
    "id": "travel",
    "name": "Travel",
    "nameBn": "ভ্রমণের দোয়া",
    "duas": [
      {
        "id": "travel-1",
        "arabic": "سُبْحَانَ الَّذِي سَخَّرَ لَنَا هَذَا",
        "transliteration": "Subhanalladhi sakhkhara lana hadha",
        "translation": "Glory be to the One who has subjected this to us.",
        "reference": "Quran 43:13"
      }
    ]
  }
]
