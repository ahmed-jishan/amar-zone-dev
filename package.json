{
  "name": "amar-zone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){console.warn('Skipping .next cleanup:',e.code||e.message)}\"",
    "postinstall": "node scripts/patch-google-auth-drive-scope.cjs",
    "icons": "node scripts/generate-app-icons.cjs",
    "dev": "next dev",
    "prebuild": "node scripts/patch-google-auth-drive-scope.cjs && node scripts/generate-app-icons.cjs && node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){console.warn('Skipping .next cleanup:',e.code||e.message)}\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cap:add:android": "npx cap add android && node scripts/ensure-android-permissions.cjs && node scripts/generate-app-icons.cjs",
    "cap:sync": "node scripts/patch-google-auth-drive-scope.cjs && npx cap sync && node scripts/ensure-android-permissions.cjs && node scripts/generate-app-icons.cjs",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/geolocation": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capgo/capacitor-native-biometric": "^6.0.2",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@zxing/browser": "^0.1.5",
    "adhan": "^4.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.39.0",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "lucide-react": "^0.383.0",
    "next": "^14.2.0",
    "qrcode": "^1.5.3",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.3.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.4",
    "typescript": "^5"
  }
}
