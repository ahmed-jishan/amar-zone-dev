# ─── SelfSync Voice — AI Configuration ─────────────────────────────────
# 
# Get your Groq API key from: https://console.groq.com/keys
# 
# Copy this file to .env.local and add your API key:
#   cp .env.local.example .env.local
# Then edit .env.local with your actual key.

# Required for AI-powered voice commands
NEXT_PUBLIC_GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Model selection (default: llama-4-scout-17b-16e-instruct)
# NEXT_PUBLIC_GROQ_MODEL=llama-4-scout-17b-16e-instruct