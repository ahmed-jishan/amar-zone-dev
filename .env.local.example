# Google OAuth configuration
# Copy this file to .env.local and add the OAuth client IDs.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-example.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Optional server-side Google client secret (do not expose this in the APK)
# GOOGLE_CLIENT_SECRET=your_server_side_secret